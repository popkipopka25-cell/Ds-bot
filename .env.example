# Локальный запуск: скопируйте этот файл под именем .env и впишите значения.
# На Render эти же переменные добавляются в Environment. Файл .env НЕ загружайте на GitHub.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Ваш числовой Telegram ID (обязательно). Узнать: написать боту @userinfobot
OWNER_ID=123456789

# Ваш username без @ (для красивого отображения в списках)
OWNER_USERNAME=chapapshk1

# Строка подключения Neon (обязательно): Neon → Dashboard → Connect → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ID группы клана (необязательно). Проще не заполнять: напишите /setgroup в группе.
# Привязка хранится в Neon и переживает перезапуски.
GROUP_ID=

# Часовой пояс для дат в сообщениях
TIMEZONE=Europe/Kyiv

# Присылать ежедневную копию базы владельцу в личку (true/false)
BACKUP_SEND_TO_OWNER=true
